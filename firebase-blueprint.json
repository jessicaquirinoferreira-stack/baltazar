{
  "entities": {
    "siteSettings": {
      "title": "SiteSettings",
      "description": "Global website configuration, colors, and institutional texts",
      "type": "object",
      "properties": {
        "title": { "type": "string", "maxLength": 150 },
        "consultantName": { "type": "string", "maxLength": 100 },
        "tagline": { "type": "string", "maxLength": 200 },
        "phone": { "type": "string", "maxLength": 30 },
        "whatsapp": { "type": "string", "maxLength": 30 },
        "whatsappMessage": { "type": "string", "maxLength": 300 },
        "instagram": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "maxLength": 100 },
        "city": { "type": "string", "maxLength": 100 },
        "coverageRegions": { "type": "string", "maxLength": 100 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["consultantName", "phone", "whatsapp"]
    },
    "operator": {
      "title": "Operator",
      "description": "Healthcare and insurance operators available in the portfolio",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "name": { "type": "string", "maxLength": 100 },
        "slug": { "type": "string", "maxLength": 100 },
        "category": { "type": "string", "maxLength": 50 },
        "modalities": { "type": "string", "maxLength": 200 },
        "coverage": { "type": "string", "maxLength": 150 },
        "description": { "type": "string", "maxLength": 500 },
        "badge": { "type": "string", "maxLength": 60 },
        "logoUrl": { "type": "string", "maxLength": 500 },
        "featured": { "type": "boolean" },
        "active": { "type": "boolean" },
        "order": { "type": "number" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "slug", "active"]
    },
    "lead": {
      "title": "Lead",
      "description": "Commercial quotation requests and inquiries submitted by visitors",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "name": { "type": "string", "maxLength": 120 },
        "phone": { "type": "string", "maxLength": 30 },
        "email": { "type": "string", "maxLength": 120 },
        "city": { "type": "string", "maxLength": 100 },
        "state": { "type": "string", "maxLength": 10 },
        "planType": { "type": "string", "maxLength": 60 },
        "beneficiariesCount": { "type": "number" },
        "companyName": { "type": "string", "maxLength": 150 },
        "companyLives": { "type": "string", "maxLength": 50 },
        "ageGroups": { "type": "string", "maxLength": 200 },
        "accommodation": { "type": "string", "maxLength": 40 },
        "coparticipation": { "type": "string", "maxLength": 40 },
        "preferredOperators": { "type": "string", "maxLength": 250 },
        "notes": { "type": "string", "maxLength": 1000 },
        "source": { "type": "string", "maxLength": 100 },
        "campaignId": { "type": "string", "maxLength": 100 },
        "status": { "type": "string", "maxLength": 50 },
        "adminNotes": { "type": "string", "maxLength": 1500 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "phone", "planType", "status"]
    },
    "campaign": {
      "title": "Campaign",
      "description": "Marketing campaigns and customizable landing page tracking",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "title": { "type": "string", "maxLength": 120 },
        "slug": { "type": "string", "maxLength": 100 },
        "headline": { "type": "string", "maxLength": 200 },
        "subheadline": { "type": "string", "maxLength": 300 },
        "targetAudience": { "type": "string", "maxLength": 100 },
        "planType": { "type": "string", "maxLength": 60 },
        "active": { "type": "boolean" },
        "utmSource": { "type": "string", "maxLength": 50 },
        "utmMedium": { "type": "string", "maxLength": 50 },
        "utmCampaign": { "type": "string", "maxLength": 100 },
        "viewsCount": { "type": "number" },
        "leadsCount": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "slug", "planType", "active"]
    },
    "analyticsEvent": {
      "title": "AnalyticsEvent",
      "description": "Aggregated visitor interactions, quotes requested, and whatsapp clicks",
      "type": "object",
      "properties": {
        "eventType": { "type": "string", "maxLength": 60 },
        "path": { "type": "string", "maxLength": 200 },
        "label": { "type": "string", "maxLength": 150 },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["eventType", "path"]
    }
  },
  "firestore": {
    "/siteSettings/{settingId}": {
      "schema": "siteSettings",
      "description": "Global website settings documents"
    },
    "/operators/{operatorId}": {
      "schema": "operator",
      "description": "Available health plan and insurance operators"
    },
    "/leads/{leadId}": {
      "schema": "lead",
      "description": "Quotation requests and leads submitted via site"
    },
    "/campaigns/{campaignId}": {
      "schema": "campaign",
      "description": "Marketing campaigns and landing pages"
    },
    "/analyticsEvents/{eventId}": {
      "schema": "analyticsEvent",
      "description": "Anonymous tracking events for visits and conversions"
    }
  }
}
